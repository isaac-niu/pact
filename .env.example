# Copy to .env — never commit .env
# Shared names for all four laptops. Values live in the group chat / server only.

PORT=3000
BIND_HOST=127.0.0.1
NODE_ENV=development

# Gemini Flash (Person C) — image input, not image generation
# Current Flash for new AI Studio keys (2.5-flash is retired for new users)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# IFM sidekick (optional) — a color-commentator one-liner reacting to the
# referee's verdict, via Hugging Face's router to an IFM K2 Horizon model
# (https://ifm.ai). App runs without this; falls back to canned lines.
HF_TOKEN=
IFM_SIDEKICK_MODEL=IFM/K2-Horizon-0.9B

# Auth0 (Person B)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_SECRET=

# Browser-safe Auth0 / API (Vite exposes only VITE_* vars)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_CALLBACK_URL=http://localhost:5173/callback
VITE_API_URL=http://localhost:3001

# MongoDB Atlas (Person B) — Person C writes GridFS proof + verdict onto the pact
MONGODB_URI=
MONGODB_DB_NAME=pact
MONGO_DB_NAME=pact

# ElevenLabs announcer (Person D, optional). App runs without this.
# Custom/library voices often 402 on the free plan; the server falls back to Adam.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Leave unset (or anything other than 1) for live Auth0 + Atlas.
# PACT_MOCK_AUTH=1

# Solana wallet (/wallet page only, real devnet). Optional custom RPC
# endpoint; leave unset to use the public devnet cluster.
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Safety for scripts/seed-demo.mjs — never true on the live box unless you mean it
DEMO_SEED=false
DEMO_SEED_PRODUCTION=false

# Public HTTPS URL after Vultr TLS is up (Auth0 callbacks / logout / web origins)
PUBLIC_URL=
