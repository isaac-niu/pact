# Copy to .env — never commit .env
# Shared names for all four laptops. Values live in the group chat / server only.

PORT=3000
BIND_HOST=127.0.0.1
NODE_ENV=development

# Auth0 (Person B)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# MongoDB Atlas (Person B)
MONGODB_URI=

# Gemini Flash (Person C) — image input, not image generation
GEMINI_API_KEY=

# ElevenLabs announcer (Person D, optional). App runs without this.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Safety for scripts/seed-demo.mjs — never true on the live box unless you mean it
DEMO_SEED=false
DEMO_SEED_PRODUCTION=false

# Public URL after Vultr is up (add this to Auth0 callbacks / logout / web origins)
PUBLIC_URL=
